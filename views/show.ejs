<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <style> table,tr,td { border: 1px solid black; }</style>
</head>
<body>
    <table>
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Email</th>
        </tr>
        <% for(let user of users) { %>
            <tr>
                <td><%= user.id %></td>
                <td><%= user.username %></td>
                <td><%= user.email %></td>
        
            <td>
                <form method="GET" action="/user/<%= user.id %>/edit">
    <button type="submit">Edit UserName</button>
</form>
        
        </td>
        </tr>
        <% }; %>
    </table>
    
</body>
</html>